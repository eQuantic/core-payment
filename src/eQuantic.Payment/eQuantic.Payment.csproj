<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Unified payment abstraction for Brazilian payment providers. Single request/response model with provider and API version metadata, adaptable to any gateway (Pagar.me, Stripe, etc).</Description>
    <PackageTags>payment;gateway;pix;boleto;credit-card;brazil;pagarme;stripe</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
