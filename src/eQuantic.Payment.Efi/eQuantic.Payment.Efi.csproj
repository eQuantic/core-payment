    <PackageTags>payment;efi;gerencianet;pix;boleto;credit-card;brazil</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="eQuantic.Mapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\eQuantic.Payment\eQuantic.Payment.csproj" />
  </ItemGroup>

</Project>
