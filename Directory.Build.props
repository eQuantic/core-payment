<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>eQuantic Tech</Authors>
    <Company>eQuantic Tech</Company>
    <Product>eQuantic Payment</Product>
    <Copyright>2026 eQuantic Tech</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/eQuantic/core-payment</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eQuantic/core-payment</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The development default. A release packs at the version semantic-release computed and writes
         it back here (.github/scripts/release-prepare.sh), so this reads the last one published. -->
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    What every package shows on nuget.org: the eQuantic mark, its own README and the MIT license. The
    icon is the same file every eQuantic package carries (assets/Icon.png); the README is each project's
    own README.md, packed by src/Directory.Build.targets, so the page GitHub shows for a folder is the
    page its package shows.
  -->
  <PropertyGroup Label="Package page">
    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets/Icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
